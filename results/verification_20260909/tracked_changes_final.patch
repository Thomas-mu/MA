+ODR_CODES = {25: 0x08, 50: 0x09, 100: 0x0A, 200: 0x0B, 400: 0x0C, 800: 0x0D}
+RANGE_CODES = {2: 0, 4: 1, 8: 2, 16: 3}
+
+
+@dataclass(frozen=True)
+class FreshSample:
+    xyz_g: tuple[float, float, float]
+    monotonic_ns: int
+    sample_index: int
+    sensor_time_estimate_s: float
+    fifo_depth: int
+    overrun: bool
+    gap: bool
+    saturated: bool
+    read_duration_ns: int
